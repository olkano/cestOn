{
  "name": "ceston",
  "version": "0.1.0-dev.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {"node": ">=24 <25", "npm": ">=11 <12"},
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "preinstall": "node scripts/check-runtime.mjs",
    "dev": "tsx scripts/dev.ts",
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "tsx scripts/e2e.ts",
    "test:security": "vitest run --project security",
    "test:updates": "vitest run --project updates",
    "test:providers:fixture": "vitest run packages/adapters --project unit",
    "test:providers:live": "tsx scripts/providers-live.ts",
    "test:docs": "tsx scripts/check-docs.ts",
    "verify": "tsx scripts/verify.ts",
    "package:local": "tsx scripts/package.ts",
    "doctor": "tsx scripts/doctor.ts",
    "icons": "tsx scripts/icons.ts",
    "checkpoint": "tsx scripts/checkpoint.ts"
  },
  "overrides": {"@typescript-eslint/typescript-estree": {"minimatch": "11.0.1"}},
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
