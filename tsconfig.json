{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true,
    "jsx": "react-jsx", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"], "forceConsistentCasingInFileNames": true
  },
  "include": ["apps", "packages", "scripts", "tests", "*.config.ts"]
}
